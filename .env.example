# =============================================
# THE STITCH HOUSE — Environment Variables
# =============================================

# --- DATABASE (Local SQLite for dev) ---
# For LOCAL development, use sqlite:
# DATABASE_URL="file:./dev.db"
#
# For PRODUCTION on Vercel + Neon PostgreSQL, use:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- JWT SECRET (Change this to a long random string in production!) ---
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# --- CLOUDINARY (Free image uploads — sign up at cloudinary.com) ---
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- SITE URL (Your Vercel domain once deployed) ---
NEXT_PUBLIC_SITE_URL="https://the-stitch-house.vercel.app"

# --- WhatsApp Business Number (with country code, no + or spaces) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
